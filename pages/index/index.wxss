.container {
  padding: 20rpx 24rpx;
  padding-bottom: 160rpx;
}

/* 搜索 */
.search-bar {
  position: relative;
  margin-bottom: 20rpx;
}
.search-input {
  width: 100%;
  background: #1a2035;
  border: 1rpx solid #2a3150;
  border-radius: 16rpx;
  padding: 20rpx 60rpx 20rpx 24rpx;
  color: #e8eaf0;
  font-size: 28rpx;
}
.search-clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #5a6178;
  font-size: 32rpx;
  padding: 10rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.stats {
  font-size: 24rpx;
  color: #5a6178;
}
.sync-btn {
  font-size: 24rpx;
  color: #9d92f8;
  padding: 8rpx 20rpx;
  border: 1rpx solid #2a3150;
  border-radius: 20rpx;
}
.sync-btn:active {
  background: rgba(124, 110, 240, 0.15);
}

/* 视频列表 */
.video-item {
  display: flex;
  align-items: center;
  background: #1a2035;
  border: 1rpx solid #2a3150;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  transition: 0.2s;
}
.video-item:active {
  background: #222b45;
  border-color: #7c6ef0;
}

.item-cover {
  position: relative;
  width: 160rpx;
  height: 90rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #111827;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.duration {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  background: rgba(0,0,0,0.75);
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.item-body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.item-title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 6rpx;
}
.item-meta {
  font-size: 22rpx;
  color: #5a6178;
  margin-bottom: 8rpx;
}
.item-tags {
  display: flex;
  flex-wrap: wrap;
}

.item-actions {
  flex-shrink: 0;
}
.del-btn {
  padding: 10rpx;
  font-size: 32rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
