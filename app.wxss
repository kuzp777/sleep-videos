/* 全局样式 - 暗色主题 */
page {
  background: #0a0e1a;
  color: #e8eaf0;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: #1a2035;
  border: 1rpx solid #2a3150;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-group label {
  display: block;
  font-size: 24rpx;
  color: #8b92a8;
  margin-bottom: 8rpx;
}

.input-group input,
.input-group textarea {
  width: 100%;
  background: #111827;
  border: 1rpx solid #2a3150;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: #e8eaf0;
  font-size: 28rpx;
}

.input-group input:focus,
.input-group textarea:focus {
  border-color: #7c6ef0;
}

.input-group textarea {
  min-height: 160rpx;
}

.input-group .hint {
  font-size: 22rpx;
  color: #5a6178;
  margin-top: 6rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.btn-primary {
  background: #7c6ef0;
  color: #fff;
}

.btn-primary:active {
  background: #6b5de0;
}

.btn-secondary {
  background: #1a2035;
  color: #e8eaf0;
  border: 1rpx solid #2a3150;
}

.btn-danger {
  background: #e04040;
  color: #fff;
}

.btn-block {
  display: flex;
  width: 100%;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #9d92f8;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #5a6178;
}

.empty .icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.msg {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin: 16rpx 0;
}

.msg-ok {
  background: rgba(40, 200, 80, 0.12);
  color: #50d070;
}

.msg-err {
  background: rgba(224, 64, 64, 0.12);
  color: #f06060;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  background: rgba(124, 110, 240, 0.12);
  color: #9d92f8;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin: 4rpx 4rpx 4rpx 0;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10, 14, 26, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #2a3150;
}
